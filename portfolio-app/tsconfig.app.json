{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": [
    "env.d.ts",
    "src/**/*",
    "src/**/*.vue",
    "src/types/**/*.d.ts" // ⬅ important
  ],
  "exclude": ["src/**/__tests__/*"],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "types": [],
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "target": "ES2021",
    "lib": ["ES2021", "DOM"],

    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
